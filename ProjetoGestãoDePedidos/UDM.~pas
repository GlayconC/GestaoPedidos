unit UDM;

interface

uses
  SysUtils, Classes, Forms, Dialogs, IBDatabase, DB, IBCustomDataSet, IBQuery, DBTables;

type
  TDM = class(TDataModule)
    IBDatabase1: TIBDatabase;
    IBTransaction1: TIBTransaction;
    IBQueryClientes: TIBQuery;
    dsClientes: TDataSource;
    dsConsulta: TDataSource;
    IBQueryConsulta: TIBQuery;
    IBQueryProdutos: TIBQuery;
    dsProdutos: TDataSource;
    procedure DataModuleCreate(Sender:TObject);
  private
    procedure ConfigurarConexao;
    function ArquivoConfiguracao: String;
    procedure TratarExcecaoAplicacao(Sender: TObject; E: Exception);
  public
    procedure PesquisarClientes(const ANome: String);
    procedure CarregarClientes;
    procedure SalvarCliente(
      AChave: Integer;
      const ANome,
            ACPF,
            AEndereco,
            ATelefone: String
      );
    procedure BuscarCliente(AChave: Integer);
    procedure AlterarCliente (
      AChave: Integer;
      const ANome,
            ACPF,
            AEndereco,
            ATelefone: String);
    procedure ExcluirCliente(AChave: Integer);
    procedure ExecutarConsulta(const ASQL: String);

    procedure BuscarProduto(const ACodigo: String);
    procedure SalvarProduto(
        const ACodigo, ANome, ADescricao: String;
        const APreco: Currency;
        const AQuantidade: Integer
    );
    procedure AlterarProduto(
      const ACodigo, ANome, ADescricao: String;
      const APreco: Currency;
      const AQuantidade: Integer
    );
    procedure ExcluirProduto(const ACodigo: String);
    function ProdutoPossuiItensPedido(const ACodigo: String): Boolean;
    function ClienteExiste(AChave: Integer): Boolean;
  end;

var
  DM: TDM;

implementation

uses
  IniFiles, URegistroErros;

{$R *.dfm}

// Carregar Clientes
procedure TDM.CarregarClientes;
begin
    if IBQueryClientes.Active then
      IBQueryClientes.Close;

    IBQueryClientes.Open;
end;

//Salvar Clientes
procedure TDM.SalvarCliente(
  AChave: Integer;
  const ANome,
        ACPF,
        AEndereco,
        ATelefone: String);
  begin
      if not IBTransaction1.InTransaction then
        IBTransaction1.StartTransaction;

      IBQueryClientes.Close;
      IBQueryClientes.SQL.Clear;

      IBQueryClientes.SQL.Add(
        'INSERT INTO CLIENTES ' +
        '(CHAVE, NOME, CPF, ENDERECO, TELEFONE) ' +
        'VALUES (:CHAVE, :NOME, :CPF, :ENDERECO, :TELEFONE)'
      );

      IBQueryClientes.ParamByName('CHAVE').AsInteger := AChave;
      IBQueryClientes.ParamByName('NOME').AsString := ANome;
      IBQueryClientes.ParamByName('CPF').AsString := ACPF;
      IBQueryClientes.ParamByName('ENDERECO').AsString := AEndereco;
      IBQueryClientes.ParamByName('TELEFONE').AsString := ATelefone;

      IBQueryClientes.ExecSQL;

      IBTransaction1.CommitRetaining;
  end;

procedure TDM.BuscarCliente(AChave: Integer);
begin
  if IBQueryClientes.Active then
    IBQueryClientes.Close;

    IBQueryClientes.SQL.Clear;
    IBQueryClientes.SQL.Add(
      'SELECT CHAVE, NOME, CPF, ENDERECO, TELEFONE ' +
      'FROM CLIENTES ' +
      'WHERE CHAVE = :CHAVE');

    IBQueryClientes.ParamByName('CHAVE').AsInteger := AChave;

    IBQueryClientes.Open;
end;

procedure TDM.AlterarCliente(AChave: Integer;
                              const ANome,
                                    ACPF,
                                    AEndereco,
                                    ATelefone: String);
begin
  if not IBTransaction1.InTransaction then
    IBTransaction1.StartTransaction;

  IBQueryClientes.Close;
  IBQueryClientes.SQL.Clear;

  IBQueryClientes.SQL.Add(
    'UPDATE CLIENTES SET ' +
    'NOME = :NOME, ' +
    'CPF = :CPF, ' +
    'ENDERECO = :ENDERECO, ' +
    'TELEFONE = :TELEFONE ' +
    'WHERE CHAVE = :CHAVE');

  IBQueryClientes.ParamByName('NOME').AsString := ANome;
  IBQueryClientes.ParamByName('CPF').AsString := ACPF;
  IBQueryClientes.ParamByName('ENDERECO').AsString := AEndereco;
  IBQueryClientes.ParamByName('TELEFONE').AsString := ATelefone;
  IBQueryClientes.ParamByName('CHAVE').AsInteger := AChave;

  IBQueryClientes.ExecSQL;

  IBTransaction1.Commit;

end;

procedure TDM.ExcluirCliente(AChave: Integer);
begin
  if not IBTransaction1.InTransaction then
    IBTransaction1.StartTransaction;

  try
    IBQueryClientes.Close;
    IBQueryClientes.SQL.Clear;

    IBQueryClientes.SQL.Add(
      'DELETE FROM CLIENTES ' +
      'WHERE CHAVE = :CHAVE');

    IBQueryClientes.ParamByName('CHAVE').AsInteger := AChave;

    IBQueryClientes.ExecSQL;

    IBTransaction1.Commit;
  except
    IBTransaction1.Rollback;

    raise;
  end;
end;

procedure TDM.ExecutarConsulta(const ASQL: String);
begin
    if IBQueryConsulta.Active then
      IBQueryConsulta.Close;

    IBQueryConsulta.SQL.Clear;
    IBQueryConsulta.SQL.Add(ASQL);

    IBQueryConsulta.Open;
end;

procedure TDM.BuscarProduto(const ACodigo: String);
begin
  if IBQueryProdutos.Active then
    IBQueryProdutos.Close;

  IBQueryProdutos.SQL.Clear;
  IBQueryProdutos.SQL.Add(
    'SELECT CODIGO, NOME, DESCRICAO, PRECO, ESTOQUE ' +
    'FROM PRODUTOS ' +
    'WHERE CODIGO = :CODIGO'
  );

  IBQueryProdutos.ParamByName('CODIGO').AsString := ACodigo;
  IBQueryProdutos.Open;
end;

procedure TDM.SalvarProduto(
  const ACodigo, ANome, ADescricao: String;
  const APreco: Currency;
  const AQuantidade: Integer
);
begin
  if not IBTransaction1.InTransaction then
    IBTransaction1.StartTransaction;
  try
    IBQueryProdutos.Close;
    IBQueryProdutos.SQL.Clear;
    IBQueryProdutos.SQL.Add(
      'INSERT INTO PRODUTOS ' +
      '(CODIGO, NOME, DESCRICAO, PRECO, ESTOQUE) ' +
      'VALUES ' +
      '(:CODIGO, :NOME, :DESCRICAO, :PRECO, :ESTOQUE)'
    );

    IBQueryProdutos.ParamByName('CODIGO').AsString := ACodigo;
    IBQueryProdutos.ParamByName('NOME').AsString := ANome;
    IBQueryProdutos.ParamByName('DESCRICAO').AsString := ADescricao;
    IBQueryProdutos.ParamByName('PRECO').AsCurrency := APreco;
    IBQueryProdutos.ParamByName('ESTOQUE').AsInteger := AQuantidade;

    IBQueryProdutos.ExecSQL;
    IBTransaction1.CommitRetaining;
  except
    if IBTransaction1.InTransaction then
      IBTransaction1.Rollback;

    raise;
  end;
end;

procedure TDM.AlterarProduto(
  const ACodigo, ANome, ADescricao: String;
  const APreco: Currency;
  const AQuantidade: Integer
);
begin
  if not IBTransaction1.InTransaction then
    IBTransaction1.StartTransaction;
    
  IBQueryProdutos.Close;
  IBQueryProdutos.SQL.Clear;
  IBQueryProdutos.SQL.Add(
    'UPDATE PRODUTOS SET ' +
    'NOME = :NOME, ' +
    'DESCRICAO = :DESCRICAO, ' +
    'PRECO = :PRECO, ' +
    'ESTOQUE = :ESTOQUE ' +
    'WHERE CODIGO = :CODIGO'
  );

  IBQueryProdutos.ParamByName('CODIGO').AsString := ACodigo;
  IBQueryProdutos.ParamByName('NOME').AsString := ANome;
  IBQueryProdutos.ParamByName('DESCRICAO').AsString := ADescricao;
  IBQueryProdutos.ParamByName('PRECO').AsCurrency := APreco;
  IBQueryProdutos.ParamByName('ESTOQUE').AsInteger := AQuantidade;

  IBQueryProdutos.ExecSQL;
  IBTransaction1.CommitRetaining;
end;

procedure TDM.ExcluirProduto(const ACodigo: String);
begin
  if not IBTransaction1.InTransaction then
    IBTransaction1.StartTransaction;

  IBQueryProdutos.Close;
  IBQueryProdutos.SQL.Clear;
  IBQueryProdutos.SQL.Add(
    'DELETE FROM PRODUTOS WHERE CODIGO = :CODIGO'
  );

  IBQueryProdutos.ParamByName('CODIGO').AsString := ACodigo;

  IBQueryProdutos.ExecSQL;
  IBTransaction1.CommitRetaining;
end;

function TDM.ArquivoConfiguracao: String;
begin
  Result := ExtractFilePath(Application.ExeName) + 'config.ini';
end;

procedure TDM.ConfigurarConexao;
var
  Configuracao: TIniFile;
  Servidor: String;
  CaminhoBanco:String;
  Usuario: String;
  Senha: String;
begin
  if not FileExists(ArquivoConfiguracao) then
    raise Exception.Create(
      'Arquivo config.ini não encotrado ao lado do executável'
    );

  Configuracao := TIniFile.Create(ArquivoConfiguracao);
  try
    Servidor := Trim(Configuracao.ReadString('BancoDeDados', 'Servidor', ''));
    CaminhoBanco := Trim(Configuracao.ReadString('BancoDeDados', 'Caminho', ''));
    Usuario := Trim(Configuracao.ReadString('BancoDeDados', 'Usuario', ''));
    Senha := Configuracao.ReadString('BancoDeDados', 'Senha', '');
  finally
    Configuracao.Free;
  end;

  if (Servidor = '') or (CaminhoBanco = '') then
    raise Exception.Create(
      'Informe o servidor e o caminho do banco no arquivo config.ini.'
    );

    IBDatabase1.Connected := False;
    IBDatabase1.DatabaseName := Servidor + ':' + CaminhoBanco;
    IBDatabase1.Params.Values['user_name'] := Usuario;
    IBDatabase1.Params.Values['password'] := Senha;
    IBDatabase1.Params.Values['lc_ctype'] := 'WIN1252';
end;

procedure TDM.DataModuleCreate(Sender: TObject);
begin
  Application.OnException := TratarExcecaoAplicacao;
  
  ConfigurarConexao;
end;

procedure TDM.TratarExcecaoAplicacao(
  Sender: TObject;
  E: Exception
);
begin
  RegistrarErro('Erro inesperado da aplicação', E);

  ShowMessage(
    'Ocorreu uma falha durante a operação.' + #13#10 +
    'Tente novamente. Se o problema continuar, consulte o arquivo erros.log.'
  );
end;

function TDM.ProdutoPossuiItensPedido(
  const ACodigo: String
): Boolean;
var
  Consulta: TIBQuery;
begin
  Consulta := TIBQuery.Create(nil);
  try
    Consulta.Database := IBDatabase1;
    Consulta.Transaction := IBTransaction1;

    Consulta.SQL.Add(
      'SELECT CHAVE ' +
      'FROM ITENS_PEDIDO ' +
      'WHERE PRODUTOS_CODIGO = :CODIGO ' +
      'ROWS 1'
    );

    Consulta.ParamByName('CODIGO').AsString := ACodigo;
    Consulta.Open;

    Result := not Consulta.IsEmpty;
  finally
    Consulta.Free;
  end;
end;

procedure TDM.PesquisarClientes(const ANome: String);
begin
  if IBQueryConsulta.Active then
    IBQueryConsulta.Close;

  IBQueryConsulta.SQL.Clear;

  IBQueryConsulta.SQL.Add(
    'SELECT CHAVE, NOME, CPF ' +
    'FROM CLIENTES'
  );

  if Trim(ANome) <> '' then
  begin
    IBQueryConsulta.SQL.Add(
      'WHERE NOME CONTAINING :NOME'
    );

    IBQueryConsulta.ParamByName('NOME').AsString :=
      Trim(ANome);
  end;

  IBQueryConsulta.SQL.Add('ORDER BY NOME');

  IBQueryConsulta.Open;
end;

function TDM.ClienteExiste(AChave: Integer): Boolean;
begin
  BuscarCliente(AChave);
  Result := not IBQueryClientes.IsEmpty;
end;
end.
